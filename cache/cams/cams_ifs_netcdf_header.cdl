netcdf cams_co2_ifs_forecast_europe {
dimensions:
	time = UNLIMITED ; // (24 currently)
	level = 14 ;
	latitude = 23 ;
	longitude = 31 ;
variables:
	double time(time) ;
		time:units = "hours since 2026-10-04 00:00:00" ;
		time:calendar = "proleptic_gregorian" ;
		time:long_name = "time" ;
	float level(level) ;
		level:units = "hPa" ;
		level:long_name = "pressure_level" ;
		level:standard_name = "air_pressure" ;
	float latitude(latitude) ;
		latitude:units = "degrees_north" ;
		latitude:long_name = "latitude" ;
	float longitude(longitude) ;
		longitude:units = "degrees_east" ;
		longitude:long_name = "longitude" ;
	float co2(time, level, latitude, longitude) ;
		co2:units = "ppm" ;
		co2:long_name = "Carbon dioxide mole fraction in dry air" ;
		co2:standard_name = "mole_fraction_of_carbon_dioxide_in_air" ;
		co2:_FillValue = -999.0f ;
	float co2_flux_net(time, latitude, longitude) ;
		co2_flux_net:units = "umol m-2 s-1" ;
		co2_flux_net:long_name = "Surface net CO2 flux" ;
		co2_flux_net:standard_name = "surface_net_upward_mass_flux_of_carbon_dioxide" ;
	float temperature(time, level, latitude, longitude) ;
		temperature:units = "K" ;
		temperature:long_name = "Air temperature" ;
	float geopotential_height(time, level, latitude, longitude) ;
		geopotential_height:units = "m" ;
		geopotential_height:long_name = "Geopotential height above sea level" ;

// global attributes:
		:title = "CAMS Global Greenhouse Gas Forecast - IFS Cycle 49r1" ;
		:institution = "European Centre for Medium-Range Weather Forecasts (ECMWF)" ;
		:source = "Copernicus Atmosphere Monitoring Service (CAMS)" ;
		:Conventions = "CF-1.7" ;
		:history = "2026-10-04 06:12:45 UTC : Generated by ECMWF IFS 4D-Var data assimilation" ;
		:references = "https://atmosphere.copernicus.eu/" ;
		:license = "Copernicus Open Access Software & Data License" ;
		:doi = "10.24380/cams-co2-forecast" ;
}
